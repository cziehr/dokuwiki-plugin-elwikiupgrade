{
    "name": "cziehr/dokuwiki-plugin-elwikiupgrade",
    "description": "The DokuWiki elwikiupgrade plugin (fork of the DokuWiki upgrade plugin)",
    "type": "project",
    "license": "GPLv2",
    "config": {
        "platform": {
            "php": "7.2"
        },
        "vendor-dir": "myvendor",
        "autoloader-suffix": "Elwikiupgrade"
    },
    "autoload": {
        "psr-4": {
            "dokuwiki\\plugin\\elwikiupgrade\\HTTP\\": "HTTP/"
        },
        "classmap": [
            "helper.php"
        ]
    },
    "authors": [
        {
            "name": "Andreas Gohr",
            "email": "andi@splitbrain.org"
        }
    ],
    "require": {
        "splitbrain/php-archive": "^1.3",
        "splitbrain/php-cli": "^1.3"
    }
}
